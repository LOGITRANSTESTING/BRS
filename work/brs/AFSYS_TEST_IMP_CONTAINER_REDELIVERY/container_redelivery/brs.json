  "features": [],
  "events": [
    {
      "section": "Offhire Instruct",
      "event_type": "Menu Click",
      "description": "Opens the Container Redelivery screen from Depot Activity",
      "triggered_when": "User selects Container Redelivery from the Depot Activity side panel",
      "remarks": ""
    },
    {
      "section": "Offhire Instruct",
      "event_type": "Radio Button Click",
      "description": "Shows the Offhire Instruct query fields",
      "triggered_when": "User selects the Offhire Instruct radio button",
      "remarks": ""
    },
    {
      "section": "Offhire Instruct",
      "event_type": "Button Click (Search)",
      "description": "Lists the containers matching the query fields in the grid",
      "triggered_when": "User clicks Search after entering the query fields",
      "remarks": ""
    },
    {
      "section": "Offhire Instruct",
      "event_type": "Button Click (Reset)",
      "description": "Clears all query fields",
      "triggered_when": "User clicks Reset",
      "remarks": ""
    },
    {
      "section": "Offhire Instruct",
      "event_type": "Button Click (Process)",
      "description": "Processes the selected containers for offhire",
      "triggered_when": "User clicks Process after selecting one or more containers",
      "remarks": "\"Container has processed successfully\""
    },
    {
      "section": "Offhire Instruct",
      "event_type": "Icon Click (Container History Arrangement icon)",
      "description": "Opens the Container History Arrangement pop-up with that container's redelivery history",
      "triggered_when": "User clicks the Container History Arrangement icon next to a container number in the grid",
      "remarks": ""
    },
    {
      "section": "Pre sales Instruct",
      "event_type": "Radio Button Click",
      "description": "Shows the Pre sales Instruct query fields",
      "triggered_when": "User selects the Pre sales Instruct radio button",
      "remarks": ""
    },
    {
      "section": "Pre sales Instruct",
      "event_type": "Button Click (Search)",
      "description": "Lists the containers matching the query fields in the grid",
      "triggered_when": "User clicks Search after entering the query fields",
      "remarks": ""
    },
    {
      "section": "Pre sales Instruct",
      "event_type": "Button Click (Reset)",
      "description": "Clears all query fields",
      "triggered_when": "User clicks Reset",
      "remarks": ""
    },
    {
      "section": "Pre sales Instruct",
      "event_type": "Button Click (Process)",
      "description": "Processes the selected containers for pre sales",
      "triggered_when": "User clicks Process after selecting one or more containers",
      "remarks": "\"Container has processed successfully\""
    },
    {
      "section": "Arrange",
      "event_type": "Radio Button Click",
      "description": "Shows the Arrange query fields",
      "triggered_when": "User selects the Arrange radio button",
      "remarks": ""
    },
    {
      "section": "Arrange",
      "event_type": "Button Click (Search)",
      "description": "Lists the containers matching the query fields in the grid",
      "triggered_when": "User clicks Search after entering the query fields",
      "remarks": ""
    },
    {
      "section": "Arrange",
      "event_type": "Button Click (Reset)",
      "description": "Clears all query fields",
      "triggered_when": "User clicks Reset",
      "remarks": ""
    },
    {
      "section": "Arrange",
      "event_type": "Button Click (Apply)",
      "description": "Asks for overwrite confirmation, then applies the entered Redelivery Place, Redelivery Date and Turn in Reference to the selected containers",
      "triggered_when": "User clicks Apply after selecting containers and ticking/entering the values above the grid",
      "remarks": "Alert: \"Do you want to Overwrite ?\" (OK / Cancel)"
    },
    {
      "section": "Arrange",
      "event_type": "Button Click (Process)",
      "description": "Processes the selected arranged containers",
      "triggered_when": "User clicks Process after selecting one or more containers",
      "remarks": "\"Container has processed successfully\""
    },
    {
      "section": "Arrange",
      "event_type": "Button Click (Delete)",
      "description": "Deletes the selected arranged containers",
      "triggered_when": "User clicks Delete after selecting one or more containers",
      "remarks": "\"Container Deleted Successfully\""
    }
  ],
